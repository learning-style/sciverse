import { DialogNode } from '../../types';

/**
 * B19 — Soil Biodiversity
 * Big Idea 19: "How Does Soil Support Life?"
 */
export const getB19Script = (): Record<string, DialogNode> => ({
    'root': {
        id: 'root',
        speaker: 'AI',
        content: "Welcome to Underground Ecosystems. Why is healthy soil full of organisms from microbes to worms?",
        onEnterAction: { type: 'SET_VISUAL', payload: { phase: 'intro', zoom: 'surface' } },
        options: [
            { id: 'dirt_only', label: 'Soil is mostly inert dirt with little life.', nextNodeId: 'misconception' },
