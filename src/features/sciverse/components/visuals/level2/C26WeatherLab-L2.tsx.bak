import { useCallback, useEffect, useMemo, useRef, useState } from 'react';

interface C26WeatherLabProps {
    state: Record<string, unknown>;
    onStateChange: (key: string, value: unknown) => void;
}

export const C26WeatherLab = ({ state, onStateChange }: C26WeatherLabProps) => {
    const canvasRef = useRef<HTMLCanvasElement>(null);
    const containerRef = useRef<HTMLDivElement>(null);
    const animRef = useRef<number>(0);
    const tRef = useRef(0);

    const [humidity, setHumidity] = useState(50);
    const [clouds, setClouds] = useState(50);
    const phase = (state.phase as string) || 'intro';

    // Derived chemistry state
    const precipitationChance = useMemo(() => Math.round((humidity + clouds) / 2), [humidity, clouds]);
    const summary = useMemo(() => {
        if (humidity > 70 && clouds > 70) return 'Heavy precipitation likely!';
        if (clouds > 70) return 'Cloudy, possible rain.';
        if (humidity > 70) return 'High moisture — condensation increasing.';
        if (humidity < 30) return 'Dry air, little precipitation.';
        return 'Mixed atmospheric chemistry.';
    }, [humidity, clouds]);

    const draw = useCallback(() => {
        const canvas = canvasRef.current;
        if (!canvas) return;
        const ctx = canvas.getContext('2d');
        if (!ctx) return;
        const W = canvas.width;
        const H = canvas.height;
        tRef.current += 0.016;
        const t = tRef.current;

        // Background
        ctx.fillStyle = '#f0fdfa';
        ctx.fillRect(0, 0, W, H);

        // Humidity label
        ctx.font = 'bold 32px monospace';
        ctx.fillStyle = '#06b6d4';
        ctx.fillText('HUMIDITY', W * 0.15, H * 0.18);
        ctx.font = 'bold 28px monospace';
        ctx.fillStyle = '#0e7490';
        ctx.fillText(humidity.toString(), W * 0.15, H * 0.25);

        // Clouds label
        ctx.font = 'bold 32px monospace';
        ctx.fillStyle = '#818cf8';
        ctx.fillText('CLOUDS', W * 0.55, H * 0.18);
        ctx.font = 'bold 28px monospace';
        ctx.fillStyle = '#3730a3';
        ctx.fillText(clouds.toString(), W * 0.55, H * 0.25);

        // Chemistry icon (cloud, droplet, etc.) — always show cloud scaled by slider
        const cloudScale = 0.4 + (clouds / 100) * 0.6; // 0.4 to 1.0
        const cloudAlpha = 0.3 + (clouds / 100) * 0.55;
        ctx.save();
        ctx.globalAlpha = cloudAlpha;
        ctx.beginPath();
        ctx.arc(W*0.5, H*0.42, 60 * cloudScale, Math.PI*0.8, Math.PI*2.2);
        ctx.arc(W*0.57, H*0.42, 50 * cloudScale, Math.PI*0.8, Math.PI*2.2);
        ctx.fillStyle = clouds > 70 ? '#818cf8' : '#a5b4fc';
        ctx.fill();
        ctx.restore();

        // Rain drops only when humidity AND clouds are both high
        if (humidity > 70 && clouds > 70) {
            for (let i = 0; i < 8; i++) {
                ctx.beginPath();
                ctx.ellipse(W*0.48 + i*10, H*0.52, 3, 12, 0, 0, Math.PI*2);
                ctx.fillStyle = '#06b6d4';
                ctx.fill();
            }
        }

        // Summary
        ctx.font = 'bold 24px monospace';
        ctx.fillStyle = '#334155';
        ctx.fillText(summary, W*0.5, H*0.92);

        // === Animated feedback cycle: Evaporation → Cloud Formation → Latent Heat ===
        const safeRight = W - 285;
        const cycleX = safeRight * 0.75;
        const cycleY = H * 0.75;
        const rX = Math.min(130, safeRight * 0.2);
        const rY = Math.min(65, H * 0.1);

        // Dashed ellipse track
        ctx.save();
        ctx.setLineDash([6, 4]);
        ctx.strokeStyle = '#94a3b8';
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        ctx.ellipse(cycleX, cycleY, rX, rY, 0, 0, Math.PI * 2);
        ctx.stroke();
        ctx.setLineDash([]);
        ctx.restore();

        // Stage labels — larger font
        ctx.save();
        ctx.font = 'bold 13px sans-serif';
        ctx.textAlign = 'center';
        ctx.fillStyle = '#000000';
        ctx.fillText('Step 1: ↓ Evaporation adds moisture', cycleX, cycleY - rY - 10);
        ctx.textAlign = 'left';
        ctx.fillStyle = '#dc2626';
        ctx.fillText('Step 2: Cloud formation →', cycleX + rX + 8, cycleY - 4);
        ctx.textAlign = 'right';
        ctx.fillStyle = '#000000';
        ctx.fillText('Step 4: ← Latent heat rises', cycleX - rX - 8, cycleY - 4);
        ctx.textAlign = 'center';
        ctx.fillStyle = '#dc2626';
        ctx.fillText('Step 3: ↑ Condensation fuels convection', cycleX, cycleY + rY + 16);
        ctx.restore();

        // Animated particles around the cycle
        const particleCount = 10;
        const speed = 0.25 + (humidity / 100) * 0.45;
        ctx.save();
        for (let i = 0; i < particleCount; i++) {
            const angle = ((t * speed + i / particleCount) % 1) * Math.PI * 2;
            const px = cycleX + rX * Math.cos(angle);
            const py = cycleY + rY * Math.sin(angle);
            const sz = 3 + (clouds / 100) * 3;

            const rising = Math.sin(angle) < 0;
            ctx.globalAlpha = 0.7 + 0.3 * Math.abs(Math.sin(angle));
            ctx.fillStyle = rising ? '#22d3ee' : '#a78bfa';
            ctx.beginPath();
            ctx.arc(px, py, sz, 0, Math.PI * 2);
            ctx.fill();

            // Directional arrow head
            const na = angle + 0.15;
            const dx = -rX * Math.sin(na);
            const dy = rY * Math.cos(na);
            const mag = Math.sqrt(dx * dx + dy * dy) || 1;
            const aLen = 6;
            ctx.beginPath();
            ctx.moveTo(px + (dx / mag) * aLen, py + (dy / mag) * aLen);
            ctx.lineTo(px - (dy / mag) * 2.5, py + (dx / mag) * 2.5);
            ctx.lineTo(px + (dy / mag) * 2.5, py - (dx / mag) * 2.5);
            ctx.closePath();
            ctx.fill();
        }
        ctx.restore();

        // Center label
        ctx.save();
        ctx.textAlign = 'center';
        ctx.font = 'bold 12px sans-serif';
        ctx.fillStyle = '#475569';
        ctx.fillText('Feedback Cycle', cycleX, cycleY + 3);
        ctx.restore();

        animRef.current = requestAnimationFrame(draw);
    }, [humidity, clouds, summary]);

    useEffect(() => {
        const node = containerRef.current;
        if (!node) return;
        const obs = new ResizeObserver(() => {
            const canvas = canvasRef.current;
            if (!canvas) return;
            canvas.width = node.clientWidth;
            canvas.height = node.clientHeight;
        });
        obs.observe(node);
        return () => obs.disconnect();
    }, []);

    useEffect(() => {
        cancelAnimationFrame(animRef.current);
        animRef.current = requestAnimationFrame(draw);
        return () => cancelAnimationFrame(animRef.current);
    }, [draw]);

    return (
        <div ref={containerRef} className="relative w-full h-full bg-white">
            <canvas ref={canvasRef} className="w-full h-full" />
            <div data-lab-controls="true" className="absolute left-2 bottom-2 bg-white/95 border border-slate-300 rounded-lg p-2 w-[250px] shadow-md z-10">
                <label className="text-[13px] font-extrabold text-[#06b6d4] drop-shadow">Humidity: <span className="font-extrabold">{humidity}</span></label>
                <input className="w-full accent-cyan-500 mb-0.5" type="range" min={0} max={100} value={humidity}
                    onChange={e => { const v = Number(e.target.value); setHumidity(v); onStateChange('humidity', v); }} />
                <label className="text-[13px] font-extrabold text-[#818cf8] drop-shadow">Clouds: <span className="font-extrabold">{clouds}</span></label>
                <input className="w-full accent-indigo-400" type="range" min={0} max={100} value={clouds}
                    onChange={e => { const v = Number(e.target.value); setClouds(v); onStateChange('clouds', v); }} />
            </div>
        </div>
    );
};
