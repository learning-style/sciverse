import { useCallback, useEffect, useMemo, useRef, useState } from 'react';

interface P26WeatherLabProps {
    state: Record<string, unknown>;
    onStateChange: (key: string, value: unknown) => void;
}

export const P26WeatherLab = ({ state, onStateChange }: P26WeatherLabProps) => {
    const canvasRef = useRef<HTMLCanvasElement>(null);
    const containerRef = useRef<HTMLDivElement>(null);
    const animRef = useRef<number>(0);
    const tRef = useRef(0);

    const [pressure, setPressure] = useState(50);
    const [humidity, setHumidity] = useState(50);
    const [wind, setWind] = useState(50);
    const phase = (state.phase as string) || 'intro';

    // Derived weather state
    const stormChance = useMemo(() => Math.round((pressure < 40 && humidity > 60 && wind > 60) ? 90 : (humidity + wind) / 2), [pressure, humidity, wind]);
    const summary = useMemo(() => {
        if (pressure < 40 && humidity > 60 && wind > 60) return 'High chance of storm!';
        if (humidity > 70) return 'Likely rain or fog.';
        if (wind > 70) return 'Windy conditions.';
        if (pressure > 70) return 'Clear, calm weather.';
        return 'Mixed conditions.';
    }, [pressure, humidity, wind]);

    const draw = useCallback(() => {
        const canvas = canvasRef.current;
        if (!canvas) return;
        const ctx = canvas.getContext('2d');
        if (!ctx) return;
        const W = canvas.width;
        const H = canvas.height;
        tRef.current += 0.016;
        const t = tRef.current;

        // Background
        ctx.fillStyle = '#e0f2fe';
        ctx.fillRect(0, 0, W, H);

        // Safe drawing area: avoid right panel (right 280px) and bottom-left controls (left 250px, bottom 160px)
        const safeRight = W - 285;
        const safeCenterX = safeRight / 2;

        // Variable readouts — compact row in the top-left safe zone
        ctx.textAlign = 'center';
        const labelY = H * 0.08;
        const valueY = H * 0.14;
        const col1 = safeCenterX * 0.3;
        const col2 = safeCenterX * 0.65;
        const col3 = safeCenterX * 1.0;

        ctx.font = 'bold 18px monospace';
        ctx.fillStyle = '#0ea5e9';
        ctx.fillText('PRESSURE', col1, labelY);
        ctx.font = 'bold 22px monospace';
        ctx.fillStyle = '#0369a1';
        ctx.fillText(pressure.toString(), col1, valueY);

        ctx.font = 'bold 18px monospace';
        ctx.fillStyle = '#22d3ee';
        ctx.fillText('HUMIDITY', col2, labelY);
        ctx.font = 'bold 22px monospace';
        ctx.fillStyle = '#0891b2';
        ctx.fillText(humidity.toString(), col2, valueY);

        ctx.font = 'bold 18px monospace';
        ctx.fillStyle = '#fbbf24';
        ctx.fillText('WIND', col3, labelY);
        ctx.font = 'bold 22px monospace';
        ctx.fillStyle = '#b45309';
        ctx.fillText(wind.toString(), col3, valueY);

        // Weather icon — centered in safe area, vertically centered
        const iconX = safeCenterX;
        const iconY = H * 0.5;

        if (pressure < 40 && humidity > 60 && wind > 60) {
            // Storm cloud
            ctx.save();
            ctx.globalAlpha = 0.8;
            ctx.beginPath();
            ctx.arc(iconX - 20, iconY - 20, 60, Math.PI * 0.8, Math.PI * 2.2);
            ctx.arc(iconX + 30, iconY - 20, 50, Math.PI * 0.8, Math.PI * 2.2);
            ctx.fillStyle = '#64748b';
            ctx.fill();
            ctx.restore();
            // Lightning
            ctx.save();
            ctx.beginPath();
            ctx.moveTo(iconX, iconY - 10);
            ctx.lineTo(iconX + 10, iconY + 30);
            ctx.lineTo(iconX - 10, iconY + 30);
            ctx.lineTo(iconX + 5, iconY + 70);
            ctx.lineTo(iconX + 20, iconY + 30);
            ctx.lineTo(iconX + 5, iconY + 30);
            ctx.closePath();
            ctx.fillStyle = '#fde047';
            ctx.shadowColor = '#fde047';
            ctx.shadowBlur = 10;
            ctx.fill();
            ctx.restore();
        } else if (humidity > 70) {
            // Rain cloud
            ctx.save();
            ctx.globalAlpha = 0.8;
            ctx.beginPath();
            ctx.arc(iconX - 20, iconY - 20, 60, Math.PI * 0.8, Math.PI * 2.2);
            ctx.arc(iconX + 30, iconY - 20, 50, Math.PI * 0.8, Math.PI * 2.2);
            ctx.fillStyle = '#7dd3fc';
            ctx.fill();
            ctx.restore();
            // Rain drops
            for (let i = 0; i < 6; i++) {
                ctx.beginPath();
                ctx.ellipse(iconX - 30 + i * 12, iconY + 30, 3, 10, 0, 0, Math.PI * 2);
                ctx.fillStyle = '#0ea5e9';
                ctx.fill();
            }
        } else if (wind > 70) {
            // Wind lines
            ctx.save();
            ctx.strokeStyle = '#fbbf24';
            ctx.lineWidth = 6;
            for (let i = 0; i < 3; i++) {
                ctx.beginPath();
                ctx.moveTo(iconX - 60, iconY - 20 + i * 22);
                ctx.bezierCurveTo(iconX - 20, iconY - 24 + i * 22, iconX + 20, iconY - 16 + i * 22, iconX + 60, iconY - 20 + i * 22);
                ctx.stroke();
            }
            ctx.restore();
        } else if (pressure > 70) {
            // Sun
            ctx.save();
            ctx.beginPath();
            ctx.arc(iconX, iconY, 40, 0, Math.PI * 2);
            ctx.fillStyle = '#fde047';
            ctx.shadowColor = '#fde047';
            ctx.shadowBlur = 20;
            ctx.fill();
            ctx.restore();
        }

        // Storm chance bar — positioned right of center, above bottom controls
        const barY = H * 0.22;
        const barW = Math.min(200, safeRight * 0.4);
        const barCenterX = safeRight * 0.75;
        const barX = barCenterX - barW / 2;
        ctx.textAlign = 'center';
        ctx.font = 'bold 14px monospace';
        ctx.fillStyle = '#334155';
        ctx.fillText('Storm Chance: ' + stormChance + '%', barCenterX, barY - 6);
        ctx.fillStyle = '#cbd5e1';
        ctx.fillRect(barX, barY, barW, 12);
        ctx.fillStyle = stormChance > 70 ? '#ef4444' : stormChance > 40 ? '#f59e0b' : '#22c55e';
        ctx.fillRect(barX, barY, barW * stormChance / 100, 12);

        // === Animated convection cycle diagram ===
        const cycleX = safeRight * 0.7;
        const cycleY = H * 0.78;
        const rX = Math.min(140, safeRight * 0.22);
        const rY = Math.min(70, H * 0.12);

        // Faint cycle ellipse track
        ctx.save();
        ctx.setLineDash([6, 4]);
        ctx.strokeStyle = '#94a3b8';
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        ctx.ellipse(cycleX, cycleY, rX, rY, 0, 0, Math.PI * 2);
        ctx.stroke();
        ctx.setLineDash([]);
        ctx.restore();

        // Cycle stage labels
        ctx.save();
        ctx.font = 'bold 13px sans-serif';
        ctx.textAlign = 'center';
        ctx.fillStyle = '#000000';
        ctx.fillText('Step 1: ↓ Low pressure pulls air up', cycleX, cycleY - rY - 10);
        ctx.fillStyle = '#dc2626';
        ctx.textAlign = 'left';
        ctx.fillText('Step 2: Moist air rises & cools →', cycleX + rX + 8, cycleY - 4);
        ctx.textAlign = 'right';
        ctx.fillStyle = '#000000';
        ctx.fillText('Step 4: ← Wind carries moisture', cycleX - rX - 8, cycleY - 4);
        ctx.textAlign = 'center';
        ctx.fillStyle = '#dc2626';
        ctx.fillText('Step 3: ↑ Convection amplifies cycle', cycleX, cycleY + rY + 16);
        ctx.restore();

        // Animated particles flowing around the convection ellipse
        const particleCount = 10;
        const speed = 0.3 + (wind / 100) * 0.5;
        ctx.save();
        for (let i = 0; i < particleCount; i++) {
            const phase_i = ((t * speed + i / particleCount) % 1) * Math.PI * 2;
            const px = cycleX + rX * Math.cos(phase_i);
            const py = cycleY + rY * Math.sin(phase_i);
            const size = 3 + (humidity / 100) * 3;

            // Color shifts based on position in cycle
            const top = Math.sin(phase_i) < 0;
            ctx.globalAlpha = 0.7 + 0.3 * Math.abs(Math.sin(phase_i));
            ctx.fillStyle = top ? '#38bdf8' : '#f59e0b';
            ctx.beginPath();
            ctx.arc(px, py, size, 0, Math.PI * 2);
            ctx.fill();

            // Arrow head on each particle showing direction
            const nextAngle = phase_i + 0.15;
            const dx = -rX * Math.sin(nextAngle);
            const dy = rY * Math.cos(nextAngle);
            const mag = Math.sqrt(dx * dx + dy * dy) || 1;
            const arrowLen = 6;
            ctx.beginPath();
            ctx.moveTo(px + (dx / mag) * arrowLen, py + (dy / mag) * arrowLen);
            ctx.lineTo(px - (dy / mag) * 2.5, py + (dx / mag) * 2.5);
            ctx.lineTo(px + (dy / mag) * 2.5, py - (dx / mag) * 2.5);
            ctx.closePath();
            ctx.fill();
        }
        ctx.restore();

        // Central cycle label
        ctx.save();
        ctx.textAlign = 'center';
        ctx.font = 'bold 11px sans-serif';
        ctx.fillStyle = '#475569';
        ctx.fillText('Feedback Loop', cycleX, cycleY + 3);
        ctx.restore();

        ctx.textAlign = 'start'; // reset

        animRef.current = requestAnimationFrame(draw);
    }, [pressure, humidity, wind, summary, stormChance]);

    useEffect(() => {
        const node = containerRef.current;
        if (!node) return;
        const obs = new ResizeObserver(() => {
            const canvas = canvasRef.current;
            if (!canvas) return;
            canvas.width = node.clientWidth;
            canvas.height = node.clientHeight;
        });
        obs.observe(node);
        return () => obs.disconnect();
    }, []);

    useEffect(() => {
        cancelAnimationFrame(animRef.current);
        animRef.current = requestAnimationFrame(draw);
        return () => cancelAnimationFrame(animRef.current);
    }, [draw]);

    return (
        <div ref={containerRef} className="relative w-full h-full bg-white">
            <canvas ref={canvasRef} className="w-full h-full" />
            {/* Native lab controls — styled by LessonShell global dock */}
            <div data-lab-controls="true" className="absolute left-2 bottom-2 bg-white border border-slate-300 rounded-lg p-2 w-[240px] shadow-md z-10">
                <label className="text-[13px] font-bold text-sky-600">Pressure: {pressure}</label>
                <input className="w-full accent-sky-500 mb-1" type="range" min={0} max={100} value={pressure}
                    onChange={e => { const v = Number(e.target.value); setPressure(v); onStateChange('pressure', v); }} />
                <label className="text-[13px] font-bold text-cyan-500">Humidity: {humidity}</label>
                <input className="w-full accent-cyan-400 mb-1" type="range" min={0} max={100} value={humidity}
                    onChange={e => { const v = Number(e.target.value); setHumidity(v); onStateChange('humidity', v); }} />
                <label className="text-[13px] font-bold text-amber-500">Wind: {wind}</label>
                <input className="w-full accent-amber-400" type="range" min={0} max={100} value={wind}
                    onChange={e => { const v = Number(e.target.value); setWind(v); onStateChange('wind', v); }} />
            </div>
        </div>
    );
};
